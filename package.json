{
  "name": "codywork-digital-experience",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && vite build --ssr src/prerender.tsx --outDir .prerender && node scripts/prerender.mjs && node scripts/verify-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": { "react": "^19.1.1", "react-dom": "^19.1.1" },
  "devDependencies": { "@types/react": "^19.1.10", "@types/react-dom": "^19.1.9", "typescript": "~5.9.2", "vite": "^7.1.3" }
}
